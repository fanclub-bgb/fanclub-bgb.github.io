---
import '../styles/global.css';
import '../styles/asset-overrides.css';

const base = import.meta.env.BASE_URL;

const navItems = [
  { label: 'Über BGB', href: '#about' },
  { label: 'Events', href: '#events' },
  { label: 'Mitgliedschaft', href: '#membership' },
  { label: 'Mitglieder', href: '#members' },
  { label: 'Kontakt', href: '#contact' }
];

---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Bier Guerilla Breisgau – der Fanclub des SC Freiburg." />
    <link rel="icon" type="image/png" href={`${base}favicon.ico`} />
    <title>Bier Guerilla Breisgau</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Bier Guerilla Breisgau Startseite">
        <img src={`${base}assets/bgb-logo2.png`} alt="BGB Logo" />
        <span>Bier Guerilla<br /><b>Breisgau</b></span>
      </a>
      <nav aria-label="Hauptnavigation">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <a class="header-cta" href="#membership">Dabei sein <span aria-hidden="true">↗</span></a>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title" style={`--hero-image: url('${base}assets/titleimage.png')`}>
        <div class="hero-copy">
          <p class="eyebrow">Fanclub des SC Freiburg · Seit 2013</p>
          <h1 id="hero-title">Fußball.<br /><em>Freundschaft.</em><br />Freiburg.</h1>
          <p class="hero-lead">Wir sind Bier Guerilla Breisgau. Eine Gemeinschaft für alle, die Stadionluft, gute Leute und ein kühles Bier lieben.</p>
          <div class="hero-actions">
            <a class="button button-red" href="#about">BGB kennenlernen <span aria-hidden="true">↓</span></a>
            <a class="text-link" href="#events">Was geht ab? <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="hero-photo" role="img" aria-label="Flutlicht im Stadion"></div>
        <div class="hero-stamp">NUR DER<br /><strong>SCF</strong><br /><span>★</span></div>
      </section>

      <section class="ticker" aria-label="BGB Leitgedanke">
        <span>STADIONATMOSPHÄRE</span><b>✦</b><span>GUTE LAUNE</span><b>✦</b><span>LIEBLINGSGETRÄNK</span><b>✦</b><span>GEMEINSCHAFT</span>
      </section>

      <section class="about section-grid" id="about">
        <div class="section-intro">
          <p class="eyebrow">01 / Wer wir sind</p>
          <h2>Mehr als ein<br /><em>Fanclub.</em></h2>
        </div>
        <div class="about-content">
          <p class="statement">Wir geben unserem Lieblingsgetränk im Stadion einen gebührenden Auftritt.</p>
          <p>Die Bier Guerilla Breisgau ist ein Fanclub für alle, die den SC Freiburg mit Leidenschaft begleiten. Wir treffen uns im Stadion, in der Kneipe und überall dort, wo aus Fußball echte Gemeinschaft wird.</p>
        </div>
      </section>

      <section class="events section-grid" id="events">
        <div class="section-intro">
          <p class="eyebrow">02 / Auf dem Zettel</p>
          <h2>Die nächsten<br /><em>Treffen.</em></h2>
        </div>
        <div class="event-list" id="event-list">
          <p class="events-status" id="events-status" role="status" aria-live="polite">Termine werden geladen …</p>
        </div>
      </section>

      <section class="membership" id="membership" style={`--membership-image: url('${base}assets/laststadion.jpeg')`}>
        <div class="membership-image"></div>
        <div class="membership-copy">
          <p class="eyebrow">03 / Komm dazu</p>
          <h2>Dein Platz<br />ist <em>hier.</em></h2>
          <p>Du willst Stadionatmosphäre, gute Laune und mit uns Bier trinken? Dann werde Teil der Bier Guerilla Breisgau. Der Mitgliedsbeitrag beträgt 20 EUR pro Saison.</p>
          <div class="document-links">
            <a class="button button-cream" href={`${base}assets/pdfs/BGB_Beitritt.pdf`} target="_blank">BGB Mitgliedsantrag <span aria-hidden="true">↗</span></a>
            <a class="document-link" href={`${base}assets/pdfs/SatzungSCFBierGuerillaBreisgau.pdf`} target="_blank">Satzung ansehen <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="members section-grid" id="members">
        <div class="section-intro">
          <p class="eyebrow">04 / Gemeinsam dabei</p>
          <h2>Unsere<br /><em id="member-count">Mitglieder.</em></h2>
        </div>
        <div class="member-list" id="member-list">
          <p class="members-status" id="members-status" role="status" aria-live="polite">Mitglieder werden geladen …</p>
        </div>
        <template id="beer-icon-template">
          <svg aria-hidden="true" viewBox="0 0 32 32" fill="none">
            <path d="M22 11h3a4 4 0 0 1 0 8h-3" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
            <path d="M6 10h16l-2 18H8L6 10Z" fill="#e8b846" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
            <path d="M5 10c0-2 1.5-3.5 3.5-3.5.5-2 2-3 4-3 1.5 0 2.5.7 3 2 2.7-1.3 5.5.5 5.5 3v1H5Z" fill="#f2eddf" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
          </svg>
        </template>
      </section>

      <section class="contact" id="contact">
        <div><p class="eyebrow">05 / Sag Hallo</p><h2>Auf ein Bier?</h2></div>
        <div class="contact-details">
          <p>Kontaktiert uns persönlich im Stadion, in der Kneipe oder über unsere Online-Kanäle.</p>
          <a class="email" href="mailto:info@bierguerillabreisgau.de">info@bierguerillabreisgau.de <span aria-hidden="true">↗</span></a>
          <div class="socials">
            <a href="https://instagram.com/bierguerillabreisgau" target="_blank" rel="noreferrer">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2" />
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
              </svg>
              Instagram
            </a>
            <a href="https://de-de.facebook.com/bierguerillabreisgau/" target="_blank" rel="noreferrer">
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path fill="currentColor" d="M13.5 21v-8.2h2.8l.4-3.2h-3.2v-2c0-.9.3-1.5 1.6-1.5h1.7V3.2c-.3 0-1.3-.2-2.5-.2-2.5 0-4.2 1.5-4.2 4.3v2.3H7.3v3.2h2.8V21h3.4Z" />
              </svg>
              Facebook
            </a>
            <a href="https://x.com/B_Guerilla" target="_blank" rel="noreferrer">
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path fill="currentColor" d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3L12 14.6 5.5 22H2.3l7.3-8.4L1.8 2h6.5l4.5 6.8L18.9 2Zm-1.1 17.9h1.7L7.3 4H5.5l12.3 15.9Z" />
              </svg>
            </a>
          </div>
        </div>
      </section>
    </main>

    <script>
      interface Match {
        name: string;
        date: string;
        homeTeam: string;
        awayTeam: string;
        doorOpeningTime: string;
        isPublished: boolean;
      }

      interface Member {
        id: string;
        name: string;
        avatar?: string | null;
        deletionTime?: string | null;
      }

      const apiOrigin = 'https://planthegame.ch';
      const tenantId = 'e5a30adc-0ded-4511-a10c-17e9078a49bf';
      const season = '2026-27';
      const eventsUrl = `${apiOrigin}/Match/${tenantId}/${season}/active/true`;
      const eventList = document.querySelector<HTMLDivElement>('#event-list');
      const eventStatus = document.querySelector<HTMLParagraphElement>('#events-status');
      const memberList = document.querySelector<HTMLDivElement>('#member-list');
      const membersStatus = document.querySelector<HTMLParagraphElement>('#members-status');
      const memberCount = document.querySelector<HTMLElement>('#member-count');
      const beerIconTemplate = document.querySelector<HTMLTemplateElement>('#beer-icon-template');

      function isMatch(value: unknown): value is Match {
        if (typeof value !== 'object' || value === null) return false;

        const match = value as Record<string, unknown>;
        return typeof match.name === 'string'
          && typeof match.date === 'string'
          && typeof match.homeTeam === 'string'
          && typeof match.awayTeam === 'string'
          && typeof match.doorOpeningTime === 'string'
          && typeof match.isPublished === 'boolean';
      }

      function isMember(value: unknown): value is Member {
        if (typeof value !== 'object' || value === null) return false;

        const member = value as Record<string, unknown>;
        return typeof member.id === 'string'
          && typeof member.name === 'string'
          && (member.deletionTime === undefined || member.deletionTime === null || typeof member.deletionTime === 'string')
          && (member.avatar === undefined || member.avatar === null || typeof member.avatar === 'string');
      }

      function parseMatchDate(value: string): Date | null {
        const parts = /^(\d{2})\.(\d{2})\.(\d{4})\s*-\s*(\d{2}):(\d{2})$/.exec(value);
        if (!parts) return null;

        const [, dayText, monthText, yearText, hourText, minuteText] = parts;
        const day = Number(dayText);
        const month = Number(monthText);
        const year = Number(yearText);
        const hour = Number(hourText);
        const minute = Number(minuteText);
        const date = new Date(year, month - 1, day, hour, minute);

        if (date.getFullYear() !== year || date.getMonth() !== month - 1 || date.getDate() !== day
          || date.getHours() !== hour || date.getMinutes() !== minute) {
          return null;
        }

        return date;
      }

      function showEventStatus(message: string) {
        if (eventStatus) eventStatus.textContent = message;
      }

      async function loadEvents() {
        if (!eventList || !eventStatus) {
          throw new Error('Event-Liste oder Statusanzeige wurde nicht gefunden.');
        }

        try {
          const response = await fetch(eventsUrl);
          if (!response.ok) throw new Error(`Event-API antwortete mit HTTP ${response.status}.`);

          const data: unknown = await response.json();
          if (!Array.isArray(data) || !data.every(isMatch)) {
            throw new Error('Die Event-API hat ein unerwartetes Datenformat zurückgegeben.');
          }

          const events = data
            .filter((match) => match.isPublished)
            .map((match) => ({ match, date: parseMatchDate(match.date) }))
            .map(({ match, date }) => {
              if (!date) throw new Error(`Ungültiges Event-Datum: ${match.date}`);
              return { match, date };
            })
            .filter(({ date }) => date.getTime() >= Date.now())
            .sort((a, b) => a.date.getTime() - b.date.getTime());

          eventList.replaceChildren();

          if (events.length === 0) {
            showEventStatus('Aktuell sind keine kommenden Termine veröffentlicht.');
            return;
          }

          for (const { match, date } of events) {
            const row = document.createElement('article');
            row.className = 'event-row';

            const eventDate = document.createElement('div');
            eventDate.className = 'event-date';
            const day = document.createElement('strong');
            day.textContent = new Intl.DateTimeFormat('de-DE', { day: '2-digit' }).format(date);
            const month = document.createElement('span');
            month.textContent = new Intl.DateTimeFormat('de-DE', { month: 'short' }).format(date).replace('.', '').toUpperCase();
            eventDate.append(day, month);

            const details = document.createElement('div');
            const title = document.createElement('h3');
            title.textContent = `${match.homeTeam.replaceAll('_', ' ') === 'Freiburg' ? 'Gemeinsam ins Stadion' : 'Auswärtssieg'}: ${match.name.trim()}`;
            const subtitle = document.createElement('p');
            const kickoff = new Intl.DateTimeFormat('de-DE', { hour: '2-digit', minute: '2-digit' }).format(date);
            const doorOpening = match.doorOpeningTime.trim();
            subtitle.textContent = `· Anpfiff ${kickoff} Uhr${doorOpening ? ` · Einlass ${doorOpening} Uhr` : ''}`;
            details.append(title, subtitle);
            row.append(eventDate, details);
            eventList.append(row);
          }
        } catch (error) {
          console.error('Termine konnten nicht geladen werden.', error);
          eventList.replaceChildren();
          showEventStatus('Die Termine konnten gerade nicht geladen werden. Bitte versuche es später erneut.');
        }
      }

      function showMembersStatus(message: string) {
        if (membersStatus) membersStatus.textContent = message;
      }

      function memberImage(member: Member): string {
        const avatar = member.avatar?.replaceAll(" ", "_").trim();
        if (!avatar) return '';

        const imageUrl = new URL(`/images/avatars/${encodeURIComponent(avatar)}.png`, `${apiOrigin}/`);
        if (imageUrl.protocol !== 'https:' || imageUrl.origin !== apiOrigin) {
          throw new Error(`Ungültige Avatar-URL für ${member.name}.`);
        }

        return imageUrl.href;
      }

      async function loadMembers() {
        if (!memberList || !membersStatus) {
          throw new Error('Mitgliederliste oder Statusanzeige wurde nicht gefunden.');
        }

        try {
          const response = await fetch(`${apiOrigin}/Member/${tenantId}`);
          if (!response.ok) throw new Error(`Member-API antwortete mit HTTP ${response.status}.`);

          const data: unknown = await response.json();
          if (!Array.isArray(data) || !data.every(isMember)) {
            throw new Error('Die Member-API hat ein unerwartetes Datenformat zurückgegeben.');
          }

          const currentMembers = data.filter((member) => member.deletionTime == null);
          if (memberCount) memberCount.textContent = `${currentMembers.length} Mitglieder.`;
          const rankedMembers = await Promise.all(currentMembers.map(async (member) => {
            const participantResponse = await fetch(
              `${apiOrigin}/Participant/${tenantId}/${season}/name/${encodeURIComponent(member.name.trim())}`
            );
            if (!participantResponse.ok) {
              throw new Error(`Participant-API für ${member.name} antwortete mit HTTP ${participantResponse.status}.`);
            }

            const participants: unknown = await participantResponse.json();
            if (!Array.isArray(participants)) {
              throw new Error(`Die Participant-API für ${member.name} hat ein unerwartetes Datenformat zurückgegeben.`);
            }

            return { member, participations: participants.length };
          }));

          rankedMembers.sort((a, b) => b.participations - a.participations || a.member.name.localeCompare(b.member.name, 'de'));
          memberList.replaceChildren();

          if (rankedMembers.length === 0) {
            showMembersStatus('Aktuell sind keine Mitglieder eingetragen.');
            return;
          }

          for (const { member, participations } of rankedMembers) {
            const row = document.createElement('article');
            row.className = 'member-row';

            const avatar = document.createElement('div');
            avatar.className = 'member-avatar';
            const initials = document.createElement('span');
            initials.textContent = member.name.trim().slice(0, 1).toLocaleUpperCase('de-DE');
            avatar.append(initials);

            const imageUrl = memberImage(member);
            if (imageUrl) {
              const image = document.createElement('img');
              image.src = imageUrl;
              image.alt = '';
              image.loading = 'lazy';
              initials.hidden = true;
              image.addEventListener('error', () => {
                image.remove();
                initials.hidden = false;
              }, { once: true });
              avatar.append(image);
            }

            const name = document.createElement('h3');
            name.textContent = member.name.trim();
            const count = document.createElement('p');
            count.className = 'member-beers';
            count.setAttribute('aria-label', `${participations} Bier`);
            count.append(document.createTextNode(String(participations)));
            if (beerIconTemplate) count.append(beerIconTemplate.content.cloneNode(true));
            row.append(avatar, name, count);
            memberList.append(row);
          }
        } catch (error) {
          console.error('Mitglieder konnten nicht geladen werden.', error);
          memberList.replaceChildren();
          showMembersStatus('Die Mitglieder konnten gerade nicht geladen werden. Bitte versuche es später erneut.');
        }
      }

      loadEvents();
      loadMembers();
    </script>

    <footer><span>© Bier Guerilla Breisgau</span><span>NUR DER SCF <b>✦</b></span><span>Freiburg im Breisgau</span></footer>
  </body>
</html>