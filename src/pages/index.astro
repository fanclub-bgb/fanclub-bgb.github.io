---
import '../styles/global.css';
import '../styles/asset-overrides.css';

const base = import.meta.env.BASE_URL;

const navItems = [
  { label: 'Über BGB', href: '#about' },
  { label: 'Mitgliedschaft', href: '#membership' },
  { label: 'Events', href: '#events' },
  { label: 'Schwimmnudeln', href: '#shop' },
  { label: 'Kontakt', href: '#contact' }
];

const events = [
  { date: '11', month: 'OKT', title: 'Gemeinsam ins Stadion - Bundesliga Spieltag 5 von 34', detail: 'SCF vs. Schalke' },
  { date: '15', month: 'OKT', title: 'Gemeinsam ins Stadion - UEFA Conference League Spieltag 1 von 6', detail: 'SCF vs. FK Jablonec' },
  { date: '25', month: 'OKT', title: 'Gemeinsam ins Stadion - Bundesliga Spieltag 7 von 34', detail: 'SCF vs. Bayern München' },
  { date: '28', month: 'OKT', title: 'Gemeinsam ins Stadion - DFB Pokal 2. Runde', detail: 'SCF vs. Wolfsburg' }
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Bier Guerilla Breisgau – der Fanclub des SC Freiburg." />
    <link rel="icon" type="image/png" href={`${base}favicon.ico`} />
    <title>Bier Guerilla Breisgau</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Bier Guerilla Breisgau Startseite">
        <img src={`${base}assets/bgb-logo2.png`} alt="BGB Logo" />
        <span>Bier Guerilla<br /><b>Breisgau</b></span>
      </a>
      <nav aria-label="Hauptnavigation">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <a class="header-cta" href="#membership">Dabei sein <span aria-hidden="true">↗</span></a>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title" style={`--hero-image: url('${base}assets/titleimage.png')`}>
        <div class="hero-copy">
          <p class="eyebrow">Fanclub des SC Freiburg · Seit 2013</p>
          <h1 id="hero-title">Fußball.<br /><em>Freundschaft.</em><br />Freiburg.</h1>
          <p class="hero-lead">Wir sind Bier Guerilla Breisgau. Eine Gemeinschaft für alle, die Stadionluft, gute Leute und ein kühles Bier lieben.</p>
          <div class="hero-actions">
            <a class="button button-red" href="#about">BGB kennenlernen <span aria-hidden="true">↓</span></a>
            <a class="text-link" href="#events">Was geht ab? <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="hero-photo" role="img" aria-label="Flutlicht im Stadion"></div>
        <div class="hero-stamp">NUR DER<br /><strong>SCF</strong><br /><span>★</span></div>
      </section>

      <section class="ticker" aria-label="BGB Leitgedanke">
        <span>STADIONATMOSPHÄRE</span><b>✦</b><span>GUTE LAUNE</span><b>✦</b><span>LIEBLINGSGETRÄNK</span><b>✦</b><span>GEMEINSCHAFT</span>
      </section>

      <section class="about section-grid" id="about">
        <div class="section-intro">
          <p class="eyebrow">01 / Wer wir sind</p>
          <h2>Mehr als ein<br /><em>Fanclub.</em></h2>
        </div>
        <div class="about-content">
          <p class="statement">Wir geben unserem Lieblingsgetränk im Stadion einen gebührenden Auftritt.</p>
          <p>Die Bier Guerilla Breisgau ist ein Fanclub für alle, die den SC Freiburg mit Leidenschaft begleiten. Wir treffen uns im Stadion, in der Kneipe und überall dort, wo aus Fußball echte Gemeinschaft wird.</p>
        </div>
      </section>

      <section class="events section-grid" id="events">
        <div class="section-intro">
          <p class="eyebrow">02 / Auf dem Zettel</p>
          <h2>Die nächsten<br /><em>Treffen.</em></h2>
        </div>
        <div class="event-list">
          {events.map((event) => (
            <article class="event-row">
              <div class="event-date"><strong>{event.date}</strong><span>{event.month}</span></div>
              <div><h3>{event.title}</h3><p>{event.detail}</p></div>
              <span class="event-arrow" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </section>

      <section class="membership" id="membership" style={`--membership-image: url('${base}assets/laststadion.jpeg')`}>
        <div class="membership-image"></div>
        <div class="membership-copy">
          <p class="eyebrow">03 / Komm dazu</p>
          <h2>Dein Platz<br />ist <em>hier.</em></h2>
          <p>Du willst Stadionatmosphäre, gute Laune und mit uns Bier trinken? Dann werde Teil der Bier Guerilla Breisgau. Der Mitgliedsbeitrag beträgt 20 EUR pro Saison.</p>
          <div class="document-links">
            <a class="button button-cream" href={`${base}assets/pdfs/BGB_Beitritt.pdf`} target="_blank">BGB Mitgliedsantrag <span aria-hidden="true">↗</span></a>
            <a class="document-link" href={`${base}assets/pdfs/SatzungSCFBierGuerillaBreisgau.pdf`} target="_blank">Satzung ansehen <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="shop section-grid" id="shop">
        <div class="shop-image"><img src={`${base}assets/Schwimmnudeln.jpg`} alt="BGB Schwimmnudeln in Vereinsfarben" /></div>
        <div class="shop-copy">
          <p class="eyebrow">04 / Fanartikel</p>
          <h2>Schwimmnudeln<br /><em>für den Spieltag.</em></h2>
          <p>Unser Klassiker ist zurück. Wenn du einen unserer Fanartikel möchtest, sprich uns im Stadion an oder schreib uns über die Online-Kanäle.</p>
          <a class="text-link red-link" href="#contact">Kontakt aufnehmen <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="contact" id="contact">
        <div><p class="eyebrow">05 / Sag Hallo</p><h2>Auf ein Bier?</h2></div>
        <div class="contact-details">
          <p>Kontaktiert uns persönlich im Stadion, in der Kneipe oder über unsere Online-Kanäle.</p>
          <a class="email" href="mailto:info@bierguerillabreisgau.de">info@bierguerillabreisgau.de <span aria-hidden="true">↗</span></a>
          <div class="socials">
            <a href="https://instagram.com/bierguerillabreisgau" target="_blank" rel="noreferrer">Instagram</a>
            <a href="https://de-de.facebook.com/bierguerillabreisgau/" target="_blank" rel="noreferrer">Facebook</a>
            <a href="https://twitter.com/B_Guerilla" target="_blank" rel="noreferrer">Twitter</a>
          </div>
        </div>
      </section>
    </main>

    <footer><span>© Bier Guerilla Breisgau</span><span>NUR DER SCF <b>✦</b></span><span>Freiburg im Breisgau</span></footer>
  </body>
</html>